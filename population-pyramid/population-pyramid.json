{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "usermeta": {
    "version": "1.0",
    "developedBy": "Jose Rafael Escalante",
    "gitHub": "https://github.com/jrescalante",
    "linkedIn": "https://www.linkedin.com/in/jrescalante/",
    "email": "jrescalante@sentidoanalitica.com",
    "visualName": "Population Pyramid",
    "visualDescription": "Population pyramid with historical reference years (t-10 and t-20) using year, age, sex, and people.",
    "doc": {
      "data_stage": [
        "The dataset expects year, age, sex, and people.",
        "Sex uses 1 for male and 0 for female."
      ],
      "layout_signals": [
        "Signals like centerX, barOffsetPx, plotTopInset, and the KPI positions control the visual layout.",
        "The layout keeps the central age labels readable while offsetting the bars for left/right symmetry."
      ],
      "transform_stage": [
        "The visual converts fields to numbers and builds yearly totals by age and sex.",
        "Current bars come from the latest visible year; historical reference lines are computed for year-10 and year-20."
      ],
      "visual_stage": [
        "Male values are drawn to the left and female values to the right.",
        "Historical reference lines are drawn laterally above the bars for easy comparison."
      ],
      "tooltip_stage": [
        "Tooltips expose age, sex, population, percentage of sex, and comparison year context.",
        "The comparison layer adds the relative variation for side-by-side review."
      ],
      "deneb_usage": [
        "Bind the year, age, sex, and people fields from the Power BI model or ingested table.",
        "Use `barOffsetPx` to separate the bars from the central age labels without distorting lengths."
      ],
      "doc_data": {
        "dataset": "Normalizes the base fields and derives the yearly totals by age and sex.",
        "year_age_sexo": "Groups the input by year, age, and sex after normalizing the sex code to a readable label.",
        "year_stats": "Determines the active years and the optional comparison year.",
        "pyramid": "Builds the current-year pyramid bars and signed values for left/right rendering.",
        "pyramid_compare": "Builds the comparison-year bars when two years are selected.",
        "pyramid_pct": "Calculates the share of each sex for the current-year view.",
        "pyramid_compare_pct": "Calculates the share of each sex for the comparison-year view.",
        "pyramid_delta": "Calculates absolute and relative differences against the comparison year.",
        "age_labels": "Generates centered age-range labels in five-year bands.",
        "kpi_totals_current": "Aggregates the current total population.",
        "kpi_totals_compare": "Aggregates the comparison total population.",
        "age_delta": "Computes the age-band delta used by the summary KPI.",
        "top_age_delta": "Finds the age band with the largest absolute change."
      }
    }
  },
  "description": "Population pyramid with year-based historical references for Deneb. Uses year, age, sex, and people.",
  "bounds": "flush",
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "padding": {
    "top": 24,
    "right": 44,
    "bottom": 24,
    "left": 44
  },
  "background": "#f8f3e8",
  "signals": [
    {
      "name": "centerX",
      "update": "width / 2"
    },
    {
      "name": "barOffsetPx",
      "update": "18"
    },
    {
      "name": "plotTopInset",
      "update": "52"
    },
    {
      "name": "minPctLabel",
      "update": "0"
    },
    {
      "name": "summaryKpiY",
      "update": "0"
    },
    {
      "name": "kpiCardY",
      "update": "20"
    },
    {
      "name": "kpiCardH",
      "update": "0"
    },
    {
      "name": "kpiCardW",
      "update": "width * 0.16"
    },
    {
      "name": "kpiRowLeft",
      "update": "0"
    },
    {
      "name": "kpiRowRight",
      "update": "width"
    },
    {
      "name": "kpiRowWidth",
      "update": "kpiRowRight - kpiRowLeft"
    },
    {
      "name": "kpiCol1",
      "update": "kpiRowLeft + kpiRowWidth * 0.10"
    },
    {
      "name": "kpiCol2",
      "update": "kpiRowLeft + kpiRowWidth * 0.30"
    },
    {
      "name": "kpiCol3",
      "update": "kpiRowLeft + kpiRowWidth * 0.50"
    },
    {
      "name": "kpiCol4",
      "update": "kpiRowLeft + kpiRowWidth * 0.70"
    },
    {
      "name": "kpiCol5",
      "update": "kpiRowLeft + kpiRowWidth * 0.90"
    },
    {
      "name": "comparisonActive",
      "update": "data('year_stats').length && data('year_stats')[0].year_count === 2"
    },
    {
      "name": "kpiCurrentTotal",
      "update": "data('kpi_totals_current').length ? data('kpi_totals_current')[0].current_total : 0"
    },
    {
      "name": "kpiCompareTotal",
      "update": "data('kpi_totals_compare').length ? data('kpi_totals_compare')[0].compare_total : 0"
    },
    {
      "name": "kpiDiffAbs",
      "update": "comparisonActive && data('kpi_totals_compare').length ? kpiCurrentTotal - kpiCompareTotal : null"
    },
    {
      "name": "kpiDiffPct",
      "update": "comparisonActive && data('kpi_totals_compare').length && kpiCompareTotal != 0 ? kpiDiffAbs / kpiCompareTotal : null"
    },
    {
      "name": "kpiCurrentLabel",
      "update": "format(kpiCurrentTotal, ',.0f')"
    },
    {
      "name": "kpiCompareLabel",
      "update": "comparisonActive && data('kpi_totals_compare').length ? format(kpiCompareTotal, ',.0f') : '—'"
    },
    {
      "name": "kpiDiffAbsLabel",
      "update": "comparisonActive && isValid(kpiDiffAbs) ? ((kpiDiffAbs >= 0 ? '+' : '-') + format(abs(kpiDiffAbs), ',.0f')) : '—'"
    },
    {
      "name": "kpiDiffPctLabel",
      "update": "comparisonActive && isValid(kpiDiffPct) ? ((kpiDiffPct >= 0 ? '+' : '-') + format(abs(kpiDiffPct), '.1%')) : '—'"
    },
    {
      "name": "kpiTopAgeLabel",
      "update": "comparisonActive && data('top_age_delta').length ? 'Age ' + data('top_age_delta')[0].age_label : '—'"
    },
    {
      "name": "kpiTopAgeDeltaLabel",
      "update": "comparisonActive && data('top_age_delta').length ? ((data('top_age_delta')[0].delta_age_total >= 0 ? '+' : '-') + format(abs(data('top_age_delta')[0].delta_age_total), ',.0f')) : '—'"
    },
    {
      "name": "hoveredAge",
      "value": null,
      "on": [
        {
          "events": "@bars:mouseover",
          "update": "datum.age_label"
        },
        {
          "events": "@bars:mouseout",
          "update": "null"
        }
      ]
    }
  ],
  "data": [
    {
      "name": "dataset",
      "values": [],
      "transform": [
        {
          "type": "filter",
          "expr": "isValid(datum.year) && isValid(datum.age) && isValid(datum.sex) && isValid(datum.people)"
        },
        {
          "type": "formula",
          "as": "year_num",
          "expr": "toNumber(datum.year)"
        },
        {
          "type": "formula",
          "as": "age_num",
          "expr": "toNumber(datum.age)"
        },
        {
          "type": "formula",
          "as": "sex_num",
          "expr": "toNumber(datum.sex)"
        },
        {
          "type": "formula",
          "as": "people_num",
          "expr": "toNumber(datum.people)"
        },
        {
          "type": "filter",
          "expr": "isValid(datum.year_num) && isValid(datum.age_num) && isValid(datum.sex_num) && isValid(datum.people_num)"
        }
      ]
    },
    {
      "name": "year_age_sexo",
      "source": "dataset",
      "transform": [
        {
          "type": "formula",
          "as": "sexo",
          "expr": "datum.sex_num === 2 ? 'Female' : (datum.sex_num === 1 ? 'Male' : (datum.sex_num === 0 ? 'Female' : 'Male'))"
        },
        {
          "type": "aggregate",
          "groupby": ["year_num", "age_num", "sexo"],
          "fields": ["people_num"],
          "ops": ["sum"],
          "as": ["people_total_year"]
        }
      ]
    },
    {
      "name": "years_ranked",
      "source": "year_age_sexo",
      "transform": [
        {
          "type": "aggregate",
          "groupby": ["year_num"]
        },
        {
          "type": "collect",
          "sort": {
            "field": "year_num",
            "order": "descending"
          }
        },
        {
          "type": "window",
          "ops": ["row_number"],
          "as": ["year_rank"]
        }
      ]
    },
    {
      "name": "year_stats",
      "values": [{}],
      "transform": [
        {
          "type": "formula",
          "as": "year_count",
          "expr": "data('years_ranked').length"
        },
        {
          "type": "formula",
          "as": "max_year",
          "expr": "data('years_ranked').length ? data('years_ranked')[0].year_num : null"
        },
        {
          "type": "formula",
          "as": "compare_year",
          "expr": "data('years_ranked').length === 2 ? data('years_ranked')[1].year_num : null"
        }
      ]
    },
    {
      "name": "pyramid",
      "source": "year_age_sexo",
      "transform": [
        {
          "type": "filter",
          "expr": "data('year_stats').length && (data('year_stats')[0].year_count <= 2 ? datum.year_num === data('year_stats')[0].max_year : true)"
        },
        {
          "type": "aggregate",
          "groupby": ["age_num", "sexo"],
          "fields": ["people_total_year"],
          "ops": ["sum"],
          "as": ["people_total_mode"]
        },
        {
          "type": "formula",
          "as": "people_total",
          "expr": "datum.people_total_mode"
        },
        {
          "type": "formula",
          "as": "age_label",
          "expr": "toString(datum.age_num)"
        },
        {
          "type": "formula",
          "as": "age_sexo_key",
          "expr": "toString(datum.age_num) + '|' + datum.sexo"
        },
        {
          "type": "formula",
          "as": "people_signed",
          "expr": "datum.sexo === 'Male' ? -datum.people_total : datum.people_total"
        },
        {
          "type": "formula",
          "as": "x0",
          "expr": "min(0, datum.people_signed)"
        },
        {
          "type": "formula",
          "as": "x1",
          "expr": "max(0, datum.people_signed)"
        }
      ]
    },
    {
      "name": "pyramid_compare",
      "source": "year_age_sexo",
      "transform": [
        {
          "type": "filter",
          "expr": "data('year_stats').length && data('year_stats')[0].year_count === 2 && isValid(data('year_stats')[0].compare_year) && datum.year_num === data('year_stats')[0].compare_year"
        },
        {
          "type": "formula",
          "as": "people_total_compare",
          "expr": "datum.people_total_year"
        },
        {
          "type": "formula",
          "as": "age_label",
          "expr": "toString(datum.age_num)"
        },
        {
          "type": "formula",
          "as": "age_sexo_key",
          "expr": "toString(datum.age_num) + '|' + datum.sexo"
        },
        {
          "type": "formula",
          "as": "people_signed",
          "expr": "datum.sexo === 'Male' ? -datum.people_total_compare : datum.people_total_compare"
        },
        {
          "type": "formula",
          "as": "x0",
          "expr": "min(0, datum.people_signed)"
        },
        {
          "type": "formula",
          "as": "x1",
          "expr": "max(0, datum.people_signed)"
        }
      ]
    },
    {
      "name": "sexo_totals_current",
      "source": "pyramid",
      "transform": [
        {
          "type": "aggregate",
          "groupby": ["sexo"],
          "fields": ["people_total"],
          "ops": ["sum"],
          "as": ["sexo_total"]
        }
      ]
    },
    {
      "name": "sexo_totals_compare",
      "source": "pyramid_compare",
      "transform": [
        {
          "type": "aggregate",
          "groupby": ["sexo"],
          "fields": ["people_total_compare"],
          "ops": ["sum"],
          "as": ["sexo_total_compare"]
        }
      ]
    },
    {
      "name": "pyramid_pct",
      "source": "pyramid",
      "transform": [
        {
          "type": "lookup",
          "from": "sexo_totals_current",
          "key": "sexo",
          "fields": ["sexo"],
          "values": ["sexo_total"],
          "as": ["sexo_total"]
        },
        {
          "type": "formula",
          "as": "pct_sexo",
          "expr": "isValid(datum.sexo_total) && datum.sexo_total > 0 ? datum.people_total / datum.sexo_total : 0"
        },
        {
          "type": "formula",
          "as": "pct_label",
          "expr": "format(datum.pct_sexo, '.2%')"
        }
      ]
    },
    {
      "name": "pyramid_compare_pct",
      "source": "pyramid_compare",
      "transform": [
        {
          "type": "lookup",
          "from": "sexo_totals_compare",
          "key": "sexo",
          "fields": ["sexo"],
          "values": ["sexo_total_compare"],
          "as": ["sexo_total_compare"]
        },
        {
          "type": "formula",
          "as": "pct_sexo_compare",
          "expr": "isValid(datum.sexo_total_compare) && datum.sexo_total_compare > 0 ? datum.people_total_compare / datum.sexo_total_compare : 0"
        },
        {
          "type": "formula",
          "as": "pct_label_compare",
          "expr": "format(datum.pct_sexo_compare, '.2%')"
        }
      ]
    },
    {
      "name": "pyramid_delta",
      "source": "pyramid_compare",
      "transform": [
        {
          "type": "lookup",
          "from": "pyramid",
          "key": "age_sexo_key",
          "fields": ["age_sexo_key"],
          "values": ["people_total", "x0", "x1"],
          "as": ["people_total_current", "current_x0", "current_x1"]
        },
        {
          "type": "formula",
          "as": "delta_people",
          "expr": "isValid(datum.people_total_current) ? datum.people_total_current - datum.people_total_compare : null"
        },
        {
          "type": "formula",
          "as": "delta_pct",
          "expr": "isValid(datum.people_total_compare) && datum.people_total_compare != 0 && isValid(datum.delta_people) ? datum.delta_people / datum.people_total_compare : null"
        },
        {
          "type": "formula",
          "as": "delta_label",
          "expr": "isValid(datum.delta_pct) ? ((datum.delta_pct >= 0 ? '+' : '-') + format(abs(datum.delta_pct), '.1%')) : '—'"
        }
      ]
    },
    {
      "name": "age_labels",
      "source": "pyramid_pct",
      "transform": [
        {
          "type": "aggregate",
          "groupby": ["age_num", "age_label"]
        },
        {
          "type": "formula",
          "as": "age_range_label",
          "expr": "toString(datum.age_num) + '-' + toString(datum.age_num + 4)"
        },
        {
          "type": "filter",
          "expr": "datum.age_num % 5 === 0"
        }
      ]
    },
    {
      "name": "y_domain_sorted",
      "source": "pyramid_pct",
      "transform": [
        {
          "type": "aggregate",
          "groupby": ["age_num", "age_label"]
        },
        {
          "type": "collect",
          "sort": {
            "field": "age_num",
            "order": "ascending"
          }
        }
      ]
    },
    {
      "name": "x_base_stats",
      "source": "pyramid",
      "transform": [
        {
          "type": "aggregate",
          "fields": ["people_signed", "people_signed"],
          "ops": ["min", "max"],
          "as": ["min_signed", "max_signed"]
        }
      ]
    },
    {
      "name": "x_compare_stats",
      "source": "pyramid_compare",
      "transform": [
        {
          "type": "aggregate",
          "fields": ["people_signed", "people_signed"],
          "ops": ["min", "max"],
          "as": ["min_signed", "max_signed"]
        }
      ]
    },
    {
      "name": "x_stats",
      "values": [{}],
      "transform": [
        {
          "type": "formula",
          "as": "min_signed",
          "expr": "data('x_base_stats').length ? (data('x_compare_stats').length ? min(data('x_base_stats')[0].min_signed, data('x_compare_stats')[0].min_signed) : data('x_base_stats')[0].min_signed) : 0"
        },
        {
          "type": "formula",
          "as": "max_signed",
          "expr": "data('x_base_stats').length ? (data('x_compare_stats').length ? max(data('x_base_stats')[0].max_signed, data('x_compare_stats')[0].max_signed) : data('x_base_stats')[0].max_signed) : 0"
        },
        {
          "type": "formula",
          "as": "max_abs",
          "expr": "max(abs(datum.min_signed), abs(datum.max_signed))"
        }
      ]
    },
    {
      "name": "kpi_totals_current",
      "source": "pyramid",
      "transform": [
        {
          "type": "aggregate",
          "fields": ["people_total"],
          "ops": ["sum"],
          "as": ["current_total"]
        }
      ]
    },
    {
      "name": "kpi_totals_compare",
      "source": "pyramid_compare",
      "transform": [
        {
          "type": "aggregate",
          "fields": ["people_total_compare"],
          "ops": ["sum"],
          "as": ["compare_total"]
        }
      ]
    },
    {
      "name": "current_age_totals",
      "source": "pyramid",
      "transform": [
        {
          "type": "aggregate",
          "groupby": ["age_num", "age_label"],
          "fields": ["people_total"],
          "ops": ["sum"],
          "as": ["current_age_total"]
        }
      ]
    },
    {
      "name": "compare_age_totals",
      "source": "pyramid_compare",
      "transform": [
        {
          "type": "aggregate",
          "groupby": ["age_num", "age_label"],
          "fields": ["people_total_compare"],
          "ops": ["sum"],
          "as": ["compare_age_total"]
        }
      ]
    },
    {
      "name": "age_delta",
      "source": "current_age_totals",
      "transform": [
        {
          "type": "lookup",
          "from": "compare_age_totals",
          "key": "age_num",
          "fields": ["age_num"],
          "values": ["compare_age_total"],
          "as": ["compare_age_total"]
        },
        {
          "type": "formula",
          "as": "delta_age_total",
          "expr": "isValid(datum.compare_age_total) ? datum.current_age_total - datum.compare_age_total : null"
        },
        {
          "type": "formula",
          "as": "abs_delta_age_total",
          "expr": "isValid(datum.delta_age_total) ? abs(datum.delta_age_total) : null"
        }
      ]
    },
    {
      "name": "top_age_delta",
      "source": "age_delta",
      "transform": [
        {
          "type": "filter",
          "expr": "comparisonActive && isValid(datum.abs_delta_age_total)"
        },
        {
          "type": "collect",
          "sort": {
            "field": "abs_delta_age_total",
            "order": "descending"
          }
        },
        {
          "type": "window",
          "ops": ["row_number"],
          "as": ["delta_rank"]
        },
        {
          "type": "filter",
          "expr": "datum.delta_rank == 1"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "x",
      "type": "linear",
      "domain": [
        {
          "signal": "-1 * (data('x_stats').length ? data('x_stats')[0].max_abs : 0)"
        },
        {
          "signal": "data('x_stats').length ? data('x_stats')[0].max_abs : 0"
        }
      ],
      "range": "width",
      "nice": true,
      "zero": true
    },
    {
      "name": "y",
      "type": "band",
      "domain": {
        "data": "y_domain_sorted",
        "field": "age_label"
      },
      "range": [
        {
          "signal": "height"
        },
        {
          "signal": "plotTopInset"
        }
      ],
      "padding": 0.15
    },
    {
      "name": "color",
      "type": "ordinal",
      "domain": ["Male", "Female"],
      "range": ["#6F8FAF", "#D88FA3"]
    }
  ],
  "axes": [
    {
      "orient": "bottom",
      "scale": "x",
      "title": "Population",
      "format": "~s",
      "tickCount": 6,
      "grid": false,
      "gridColor": "#e5e7eb",
      "tickColor": "#cbd5e1",
      "domainColor": "#94a3b8",
      "encode": {
        "labels": {
          "update": {
            "text": {
              "signal": "format(abs(datum.value), '~s')"
            }
          }
        }
      }
    },
    {
      "orient": "left",
      "scale": "y",
      "title": "",
      "labels": false,
      "tickSize": 0,
      "domain": false,
      "ticks": false,
      "grid": false
    }
  ],
  "legends": [],
  "marks": [
    {
      "type": "text",
      "name": "label_compare_status",
      "zindex": 6,
      "encode": {
        "update": {
          "x": { "signal": "centerX" },
          "y": { "signal": "summaryKpiY" },
          "align": { "value": "center" },
          "baseline": { "value": "top" },
          "text": {
            "signal": "data('year_stats').length ? (data('year_stats')[0].year_count === 2 && isValid(data('year_stats')[0].compare_year) ? 'Comparison: ' + data('year_stats')[0].compare_year + ' vs ' + data('year_stats')[0].max_year : (data('year_stats')[0].year_count === 1 ? 'Year ' + data('year_stats')[0].max_year : ('Years: ' + join(pluck(data('years_ranked'), 'year_num'), ', ')))) : 'Years: Total'"
          },
          "fill": { "value": "#334155" },
          "fontSize": { "value": 11.5 },
          "fontWeight": { "value": 600 },
          "letterSpacing": { "value": 0.2 },
          "opacity": { "value": 0.95 }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": { "signal": "kpiCol1" },
          "y": { "signal": "kpiCardY - 2" },
          "align": { "value": "center" },
          "baseline": { "value": "top" },
          "font": { "value": "Bahnschrift SemiBold" },
          "fontSize": { "value": 9.5 },
          "lineHeight": { "value": 14 },
          "fill": { "value": "#475467" },
          "text": { "value": "Current population" }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": { "signal": "kpiCol1" },
          "y": { "signal": "kpiCardY + 12" },
          "align": { "value": "center" },
