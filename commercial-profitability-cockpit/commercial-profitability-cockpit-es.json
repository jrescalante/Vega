{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "usermeta": {
    "version": "1.0",
    "developedBy": "José Rafael Escalante",
    "gitHub": "https://github.com/jrescalante",
    "linkedIn": "https://www.linkedin.com/in/jrescalante/",
    "email": "jrescalante@sentidoanalitica.com",
    "visualName": "Panel de Rentabilidad Comercial",
    "visualDescription": "Dispersión de rentabilidad comercial con crecimiento de ingresos, margen bruto, cuadrantes de margen objetivo y contexto KPI; listo para Deneb.",
    "doc": {
      "data_stage": [
        "El conjunto de datos espera Fecha, SKU, Ingresos, Unidades_Vendidas, Costo_Unitario, Margen Objetivo SKU y Margen Objetivo Contexto; Producto y Categoría son opcionales.",
        "Valida los campos de fecha, SKU, ingresos, unidades, costo y margen objetivo; luego calcula el margen bruto y las métricas de crecimiento de ingresos por SKU."
      ],
      "layout_signals": [
        "Las señales container/viewW/viewH controlan el tamaño responsivo; plotTop/plotBottom definen la región acotada de dispersión.",
        "Las señales de columnas KPI alinean las métricas de cabecera de manera consistente con el lenguaje visual EPD."
      ],
      "transform_stage": [
        "Calcula los últimos puntos visibles por SKU, el crecimiento de ingresos frente al primer período visible y el crecimiento alternativo frente al promedio del portafolio.",
        "Agrega el número de SKU visibles, la mezcla rentable/crítica, el porcentaje de ingresos expuestos y el margen bruto ponderado para los KPI."
      ],
      "visual_stage": [
        "Dispersión principal: X = crecimiento de ingresos frente al primer período visible, Y = brecha de margen bruto frente al objetivo trimestral por SKU.",
        "Los puntos se clasifican por crecimiento cero de ingresos y su propio margen objetivo por SKU; las líneas de referencia muestran el crecimiento cero y la línea base del objetivo.",
        "Las etiquetas guía de los ejes explican la presión de ingresos, el impulso de crecimiento y el desempeño de margen por encima o debajo del objetivo."
      ],
      "tooltip_stage": [
        "Los tooltips muestran el período, SKU, producto/categoría opcionales cuando están vinculados, cuadrante, crecimiento de ingresos, margen bruto, margen objetivo por SKU, brecha de margen, margen objetivo de referencia e ingresos."
      ],
      "deneb_usage": [
        "Pegue la especificación en Deneb y vincule los campos requeridos del modelo, incluido Margen Objetivo SKU como medida de objetivo por punto y Margen Objetivo Contexto como medida de objetivo ponderado para el contexto de filtro actual.",
        "No reemplace dataset.values con una URL local; Power BI/Deneb proporciona el conjunto de datos vinculado."
      ],
      "doc_data": {
        "dataset": "Normaliza los campos del modelo, valida las filas de entrada y calcula el margen bruto y las métricas de crecimiento.",
        "specs": "Lee el margen objetivo requerido de los datos vinculados para la línea de referencia y la división de cuadrantes.",
        "latest_points": "Conserva la última fila visible por SKU y calcula indicadores de exposición de rentabilidad para el gráfico y los KPI.",
        "kpi_stats": "Agrega las métricas del portafolio visible utilizadas por los KPI de cabecera.",
        "active_categories": "Cuenta las categorías visibles en el contexto de filtro actual.",
        "active_products": "Cuenta las combinaciones visibles de producto/categoría en el contexto de filtro actual."
      }
    }
  },
  "description": "Panel de rentabilidad comercial. Usa Fecha, SKU, Ingresos, Unidades_Vendidas, Costo_Unitario, Margen Objetivo SKU y Margen Objetivo Contexto; Producto y Categoría son opcionales. El eje Y muestra la brecha de margen frente al objetivo trimestral por SKU.",
  "bounds": "flush",
  "autosize": { "type": "fit", "contains": "padding", "resize": true },
  "padding": { "top": 18, "right": 28, "bottom": 44, "left": 42 },
  "width": { "signal": "viewW" },
  "height": { "signal": "viewH" },
  "background": "white",
  "config": {
    "locale": {
      "number": {
        "decimal": ",",
        "thousands": ".",
        "grouping": [3],
        "currency": ["", ""]
      }
    }
  },
  "signals": [
    { "name": "container", "update": "containerSize()" },
    { "name": "viewW", "update": "container[0]" },
    { "name": "viewH", "update": "container[1]" },
    { "name": "plotTop", "update": "56" },
    { "name": "plotBottomPad", "update": "0" },
    { "name": "plotHeight", "update": "max(height - plotTop - plotBottomPad, 120)" },
    { "name": "plotBottom", "update": "height" },
    { "name": "kpiRowLeft", "update": "-64" },
    { "name": "kpiRowRight", "update": "width + 84" },
    { "name": "kpiRowWidth", "update": "kpiRowRight - kpiRowLeft" },
    { "name": "kpiCol1", "update": "kpiRowLeft + kpiRowWidth * 0.10" },
    { "name": "kpiCol2", "update": "kpiRowLeft + kpiRowWidth * 0.30" },
    { "name": "kpiCol3", "update": "kpiRowLeft + kpiRowWidth * 0.50" },
    { "name": "kpiCol4", "update": "kpiRowLeft + kpiRowWidth * 0.70" },
    { "name": "kpiCol5", "update": "kpiRowLeft + kpiRowWidth * 0.90" },
    { "name": "summaryCenterX", "update": "width * 0.5" },
    { "name": "summaryContextY", "value": 2 },
    { "name": "summaryKpiY", "value": 20 },
    { "name": "quadrantLegendTop", "update": "plotTop + (plotBottom - plotTop - 90) * 0.5" },
    { "name": "contextTargetMarginPct", "update": "data('specs').length && isValid(data('specs')[0].contextTargetMarginPct) ? abs(data('specs')[0].contextTargetMarginPct) > 1 ? data('specs')[0].contextTargetMarginPct / 100 : data('specs')[0].contextTargetMarginPct : null" },
    { "name": "targetMarginY", "update": "max(plotTop, min(plotBottom, scale('y', 0)))" },
    { "name": "targetMarginLabelY", "update": "max(plotTop + 14, min(plotBottom - 8, targetMarginY - 8))" },
    { "name": "totalCategoryCount", "update": "6" },
    { "name": "activeCategoryCount", "update": "data('active_categories').length" },
    { "name": "activeProductCount", "update": "data('active_products').length" },
    { "name": "categorySelectionLabel", "update": "join(pluck(data('active_categories'), 'category'), ', ')" },
    { "name": "contextLabel", "update": "(activeCategoryCount === totalCategoryCount ? 'Vista: ' + format(totalCategoryCount, ',.0f') + ' categorías' : activeCategoryCount > 0 ? 'Vista: ' + categorySelectionLabel : 'Vista: ' + format(totalCategoryCount, ',.0f') + ' categorías') + ' | ' + format(activeProductCount, ',.0f') + ' productos'" },
    { "name": "hoveredPointQuadrant", "value": null, "on": [ { "events": "@scatter-points:mouseover", "update": "datum.quadrant" }, { "events": "@scatter-points:mouseout", "update": "null" } ] }
  ],
  "data": [
    {
      "name": "dataset",
      "values": [],
      "transform": [
        { "type": "formula", "as": "date_value", "expr": "isDate(datum.Fecha) ? datum.Fecha : toDate(datum.Fecha)" },
        { "type": "formula", "as": "sku_key", "expr": "toString(datum.SKU)" },
        { "type": "formula", "as": "has_product", "expr": "isValid(datum.Producto)" },
        { "type": "formula", "as": "product", "expr": "isValid(datum.Producto) ? toString(datum.Producto) : toString(datum.SKU)" },
        { "type": "formula", "as": "product_label", "expr": "datum.product === datum.sku_key ? datum.sku_key : datum.product + ' | ' + datum.sku_key" },
        { "type": "formula", "as": "has_category", "expr": "isValid(datum.Categoría)" },
        { "type": "formula", "as": "category", "expr": "isValid(datum.Categoría) ? toString(datum.Categoría) : null" },
        { "type": "formula", "as": "category_label", "expr": "isValid(datum.category) ? datum.category : null" },
        { "type": "formula", "as": "revenue", "expr": "toNumber(datum.Ingresos)" },
        { "type": "formula", "as": "units", "expr": "toNumber(datum.Unidades_Vendidas)" },
        { "type": "formula", "as": "unit_cost", "expr": "toNumber(datum.Costo_Unitario)" },
        { "type": "formula", "as": "targetMargin_raw", "expr": "isValid(datum['Margen Objetivo SKU']) ? toNumber(datum['Margen Objetivo SKU']) : null" },
        { "type": "formula", "as": "targetMarginReference_raw", "expr": "isValid(datum['Margen Objetivo Contexto']) ? toNumber(datum['Margen Objetivo Contexto']) : datum.targetMargin_raw" },
        { "type": "filter", "expr": "isValid(datum.date_value) && isValid(datum.sku_key) && isValid(datum.revenue) && isValid(datum.units) && isValid(datum.unit_cost) && isValid(datum.targetMargin_raw) && datum.revenue > 0 && datum.units > 0 && datum.unit_cost >= 0" },
        { "type": "formula", "as": "target_margin_pct", "expr": "abs(datum.targetMargin_raw) > 1 ? datum.targetMargin_raw / 100 : datum.targetMargin_raw" },
        { "type": "formula", "as": "target_margin_reference_pct", "expr": "abs(datum.targetMarginReference_raw) > 1 ? datum.targetMarginReference_raw / 100 : datum.targetMarginReference_raw" },
        { "type": "formula", "as": "gross_margin_total", "expr": "datum.revenue - (datum.unit_cost * datum.units)" },
        { "type": "formula", "as": "margin_pct", "expr": "datum.revenue > 0 ? datum.gross_margin_total / datum.revenue : null" },
        { "type": "formula", "as": "margin_gap_pct", "expr": "isValid(datum.margin_pct) && isValid(datum.target_margin_pct) ? datum.margin_pct - datum.target_margin_pct : null" },
        { "type": "collect", "sort": { "field": ["sku_key", "date_value"], "order": ["ascending", "ascending"] } },
        {
          "type": "window",
          "groupby": ["sku_key"],
          "sort": { "field": ["date_value"], "order": ["ascending"] },
          "ops": ["lag", "first_value", "first_value", "count"],
          "fields": ["revenue", "revenue", "date_value", null],
          "as": ["revenue_prev", "revenue_base", "date_start", "history_n"]
        },
        { "type": "formula", "as": "revenue_growth_vs_prior_pct", "expr": "isValid(datum.revenue_prev) && datum.revenue_prev != 0 ? (datum.revenue - datum.revenue_prev) / datum.revenue_prev : 0" },
        { "type": "formula", "as": "growth_vs_base_pct", "expr": "isValid(datum.revenue_base) && datum.revenue_base != 0 ? (datum.revenue - datum.revenue_base) / datum.revenue_base : 0" },
        { "type": "joinaggregate", "fields": ["revenue"], "ops": ["mean"], "as": ["revenue_mean_all"] },
        { "type": "formula", "as": "fallback_x_pct", "expr": "datum.revenue_mean_all > 0 ? (datum.revenue - datum.revenue_mean_all) / datum.revenue_mean_all : 0" }
      ]
    },
    {
      "name": "specs",
      "source": "dataset",
      "transform": [
        { "type": "aggregate", "fields": ["target_margin_reference_pct"], "ops": ["max"], "as": ["contextTargetMarginPct"] }
      ]
    },
    {
      "name": "latest_points",
      "source": "dataset",
      "transform": [
        { "type": "window", "groupby": ["sku_key"], "sort": { "field": ["date_value"], "order": ["descending"] }, "ops": ["row_number"], "as": ["rk"] },
        { "type": "filter", "expr": "datum.rk == 1 && isValid(datum.margin_pct)" },
        { "type": "formula", "as": "x_scatter", "expr": "datum.history_n > 1 ? datum.growth_vs_base_pct : datum.fallback_x_pct" },
        { "type": "formula", "as": "x_mode", "expr": "datum.history_n > 1 ? 'Crecimiento vs base' : 'Ingresos vs promedio del portafolio (alternativo)'" },
        { "type": "formula", "as": "quadrant", "expr": "datum.x_scatter < 0 && datum.margin_gap_pct >= 0 ? 'topLeft' : datum.x_scatter >= 0 && datum.margin_gap_pct >= 0 ? 'topRight' : datum.x_scatter < 0 && datum.margin_gap_pct < 0 ? 'bottomLeft' : 'bottomRight'" },
        { "type": "formula", "as": "quadrant_label", "expr": "datum.quadrant === 'topLeft' ? 'Defender volumen' : datum.quadrant === 'topRight' ? 'Crecer con rentabilidad' : datum.quadrant === 'bottomLeft' ? 'Destrucción de valor' : 'Crecimiento con riesgo de margen'" },
        { "type": "formula", "as": "is_profitable", "expr": "datum.margin_gap_pct >= 0 ? 1 : 0" },
        { "type": "formula", "as": "is_critical", "expr": "datum.margin_gap_pct < 0 ? 1 : 0" },
        { "type": "formula", "as": "exposed_revenue", "expr": "datum.margin_gap_pct < 0 ? datum.revenue : 0" }
      ]
    },
    {
      "name": "kpi_stats",
      "source": "latest_points",
      "transform": [
        {
          "type": "aggregate",
          "fields": ["sku_key", "is_profitable", "is_critical", "revenue", "exposed_revenue", "gross_margin_total"],
          "ops": ["count", "sum", "sum", "sum", "sum", "sum"],
          "as": ["sku_count", "profitable_sku_count", "critical_sku_count", "visible_revenue", "exposed_revenue_total", "gross_margin_total"]
        },
        { "type": "formula", "as": "profitable_sku_pct", "expr": "datum.sku_count > 0 ? datum.profitable_sku_count / datum.sku_count : 0" },
        { "type": "formula", "as": "critical_sku_pct", "expr": "datum.sku_count > 0 ? datum.critical_sku_count / datum.sku_count : 0" },
        { "type": "formula", "as": "exposed_revenue_pct", "expr": "datum.visible_revenue > 0 ? datum.exposed_revenue_total / datum.visible_revenue : 0" },
        { "type": "formula", "as": "weighted_gross_margin", "expr": "datum.visible_revenue > 0 ? datum.gross_margin_total / datum.visible_revenue : 0" }
      ]
    },
    { "name": "active_categories", "source": "dataset", "transform": [ { "type": "filter", "expr": "isValid(datum.category)" }, { "type": "aggregate", "groupby": ["category"] }, { "type": "formula", "as": "category_order", "expr": "datum.category === 'Cerveza' ? 0 : datum.category === 'Bebidas' ? 1 : datum.category === 'Cuidado personal' ? 2 : datum.category === 'Aperitivos' ? 3 : datum.category === 'Destilados' ? 4 : datum.category === 'Vino' ? 5 : 99" }, { "type": "collect", "sort": { "field": ["category_order", "category"], "order": ["ascending", "ascending"] } } ] },
    { "name": "active_products", "source": "dataset", "transform": [ { "type": "aggregate", "groupby": ["product", "category_label"] } ] },
    { "name": "quadrant_labels", "values": [
      { "quadrant": "topLeft", "label": "Defender volumen", "subLabel": "El margen se mantiene mientras caen los ingresos", "shape": "diamond", "detailShape": "circle", "fill": "#c2d9e9", "stroke": "#3f6f95", "detailFill": "#3f6f95", "legendText": "Margen estable, ingresos caen", "legendIndex": 0 },
      { "quadrant": "topRight", "label": "Crecer con rentabilidad", "subLabel": "Crecimiento por encima del margen objetivo", "shape": "circle", "detailShape": "cross", "fill": "#b9dec9", "stroke": "#1f6b5c", "detailFill": "#1f6b5c", "legendText": "Crecimiento sobre el objetivo", "legendIndex": 1 },
      { "quadrant": "bottomLeft", "label": "Destrucción de valor", "subLabel": "Ingresos decrecientes por debajo del objetivo", "shape": "square", "detailShape": "cross", "fill": "#e36b76", "stroke": "#a93f4b", "detailFill": "#f7f5f2", "legendText": "Caída bajo el objetivo", "legendIndex": 2 },
      { "quadrant": "bottomRight", "label": "Crecimiento con riesgo de margen", "subLabel": "Crecimiento por debajo del margen objetivo", "shape": "triangle-up", "detailShape": "triangle-down", "fill": "#f9d5b1", "stroke": "#b87235", "detailFill": "#b87235", "legendText": "Crecimiento bajo el objetivo", "legendIndex": 3 }
    ] }
  ],
  "scales": [
    { "name": "x", "type": "linear", "domain": { "data": "latest_points", "field": "x_scatter" }, "nice": true, "range": "width", "zero": true },
    { "name": "y", "type": "linear", "domain": { "data": "latest_points", "field": "margin_gap_pct" }, "domainMin": -0.35, "domainMax": 0.35, "nice": true, "range": [ { "signal": "plotBottom" }, { "signal": "plotTop" } ], "zero": true },
    { "name": "pointSize", "type": "sqrt", "domain": { "data": "latest_points", "field": "revenue" }, "range": [112, 380], "zero": true },
    { "name": "quadrantShape", "type": "ordinal", "domain": ["topLeft", "topRight", "bottomLeft", "bottomRight"], "range": ["diamond", "circle", "square", "triangle-up"] },
    { "name": "quadrantDetailShape", "type": "ordinal", "domain": ["topLeft", "topRight", "bottomLeft", "bottomRight"], "range": ["circle", "cross", "cross", "triangle-down"] },
    { "name": "quadrantFill", "type": "ordinal", "domain": ["topLeft", "topRight", "bottomLeft", "bottomRight"], "range": ["#c2d9e9", "#b9dec9", "#e36b76", "#f9d5b1"] },
    { "name": "quadrantStroke", "type": "ordinal", "domain": ["topLeft", "topRight", "bottomLeft", "bottomRight"], "range": ["#3f6f95", "#1f6b5c", "#a93f4b", "#b87235"] },
    { "name": "quadrantDetailFill", "type": "ordinal", "domain": ["topLeft", "topRight", "bottomLeft", "bottomRight"], "range": ["#3f6f95", "#1f6b5c", "#f7f5f2", "#b87235"] }
  ],
  "axes": [
    { "orient": "bottom", "scale": "x", "title": "Crecimiento de ingresos vs primer período visible", "titlePadding": 14, "format": ".0%", "grid": true, "gridColor": "#e9edf5", "gridOpacity": 1, "labelFont": "Bahnschrift", "labelFontSize": 11, "labelColor": "#667085", "titleFont": "Bahnschrift SemiBold", "titleFontSize": 12, "titleColor": "#475467", "encode": { "grid": { "update": { "y": { "value": 0 }, "y2": { "signal": "plotTop - plotBottom" } } } } },
    { "orient": "left", "scale": "y", "title": "Brecha de margen vs objetivo SKU-Q", "titlePadding": 16, "format": ".0%", "grid": true, "gridColor": "#e9edf5", "gridOpacity": 1, "labelFont": "Bahnschrift", "labelFontSize": 11, "labelColor": "#667085", "titleFont": "Bahnschrift SemiBold", "titleFontSize": 12, "titleColor": "#475467", "encode": { "grid": { "update": { "x": { "value": 0 }, "x2": { "signal": "width" } } } } }
  ],
  "legends": [],
  "marks": [
    { "type": "text", "encode": { "update": { "x": { "signal": "summaryCenterX" }, "y": { "signal": "summaryContextY" }, "align": { "value": "center" }, "baseline": { "value": "top" }, "font": { "value": "Bahnschrift" }, "fontSize": { "value": 11 }, "fill": { "value": "#7a8699" }, "text": { "signal": "contextLabel" } } } },
    { "type": "text", "encode": { "update": { "x": { "signal": "kpiCol1" }, "y": { "signal": "summaryKpiY" }, "align": { "value": "center" }, "baseline": { "value": "top" }, "font": { "value": "Bahnschrift SemiBold" }, "fontSize": { "value": 10.5 }, "fill": { "value": "#52607a" }, "text": { "signal": "'SKU visibles: ' + format(data('kpi_stats')[0].sku_count, ',.0f')" } } } },
    { "type": "text", "encode": { "update": { "x": { "signal": "kpiCol2" }, "y": { "signal": "summaryKpiY" }, "align": { "value": "center" }, "baseline": { "value": "top" }, "font": { "value": "Bahnschrift SemiBold" }, "fontSize": { "value": 10.5 }, "fill": { "value": "#52607a" }, "text": { "signal": "'SKU rentables: ' + format(data('kpi_stats')[0].profitable_sku_pct, '.0%')" } } } },
    { "type": "text", "encode": { "update": { "x": { "signal": "kpiCol3" }, "y": { "signal": "summaryKpiY" }, "align": { "value": "center" }, "baseline": { "value": "top" }, "font": { "value": "Bahnschrift SemiBold" }, "fontSize": { "value": 10.5 }, "fill": { "value": "#52607a" }, "text": { "signal": "'SKU críticos: ' + format(data('kpi_stats')[0].critical_sku_pct, '.0%')" } } } },
    { "type": "text", "encode": { "update": { "x": { "signal": "kpiCol4" }, "y": { "signal": "summaryKpiY" }, "align": { "value": "center" }, "baseline": { "value": "top" }, "font": { "value": "Bahnschrift SemiBold" }, "fontSize": { "value": 10.5 }, "fill": { "value": "#52607a" }, "text": { "signal": "'Ingresos expuestos: ' + format(data('kpi_stats')[0].exposed_revenue_pct, '.0%')" } } } },
    { "type": "text", "encode": { "update": { "x": { "signal": "kpiCol5" }, "y": { "signal": "summaryKpiY" }, "align": { "value": "center" }, "baseline": { "value": "top" }, "font": { "value": "Bahnschrift SemiBold" }, "fontSize": { "value": 10.5 }, "fill": { "value": "#52607a" }, "text": { "signal": "'Margen bruto pond.: ' + format(data('kpi_stats')[0].weighted_gross_margin, '.1%')" } } } },
    { "type": "text", "encode": { "update": { "x": { "signal": "width + 74" }, "y": { "signal": "quadrantLegendTop - 28" }, "align": { "value": "center" }, "baseline": { "value": "top" }, "font": { "value": "Bahnschrift SemiBold" }, "fontSize": { "value": 12 }, "fill": { "value": "#344054" }, "text": { "value": "Cuadrante" } } } },
    { "type": "symbol", "from": { "data": "quadrant_labels" }, "encode": { "update": { "x": { "signal": "width + 16" }, "y": { "signal": "quadrantLegendTop + datum.legendIndex * 30" }, "shape": { "field": "shape" }, "size": { "value": 100 }, "fill": { "field": "fill" }, "stroke": { "field": "stroke" }, "strokeWidth": { "value": 1.3 }, "opacity": { "value": 0.9 } } } },
    { "type": "symbol", "from": { "data": "quadrant_labels" }, "encode": { "update": { "x": { "signal": "width + 16" }, "y": { "signal": "quadrantLegendTop + datum.legendIndex * 30" }, "shape": { "field": "detailShape" }, "size": { "value": 28 }, "fill": { "field": "detailFill" }, "stroke": { "field": "stroke" }, "strokeWidth": { "value": 0.8 }, "opacity": { "value": 1 } } } },
    { "type": "text", "from": { "data": "quadrant_labels" }, "encode": { "update": { "x": { "signal": "width + 34" }, "y": { "signal": "quadrantLegendTop + datum.legendIndex * 30 - 4" }, "align": { "value": "left" }, "baseline": { "value": "middle" }, "font": { "value": "Bahnschrift" }, "fontSize": { "value": 10 }, "fill": { "value": "#475467" }, "text": { "field": "label" } } } },
    { "type": "text", "from": { "data": "quadrant_labels" }, "encode": { "update": { "x": { "signal": "width + 34" }, "y": { "signal": "quadrantLegendTop + datum.legendIndex * 30 + 8" }, "align": { "value": "left" }, "baseline": { "value": "top" }, "font": { "value": "Bahnschrift" }, "fontSize": { "value": 8.5 }, "fill": { "value": "#98a2b3" }, "text": { "field": "legendText" } } } },
    { "type": "rect", "encode": { "update": { "x": { "value": 0 }, "x2": { "scale": "x", "value": 0 }, "y": { "signal": "plotTop" }, "y2": { "signal": "targetMarginY" }, "fill": { "value": "#e7f0fb" }, "fillOpacity": { "signal": "hoveredPointQuadrant === null ? 0.34 : hoveredPointQuadrant === 'topLeft' ? 0.57 : 0.2" } } } },
